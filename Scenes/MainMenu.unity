  hints:
  - hint: "\uCCB4\uB825\uC774 \uB0AE\uC744 \uB54C\uB294 \n\uC0C1\uC790\uC5D0\uC11C
      \uB2EC\uCF64\uC6B0\uC720\uAC00 \uB098\uC62C \uD655\uB960\uC774 \n\uB192\uC544\uC9D1\uB2C8\uB2E4."
  - hint: "\uC6D4\uACC4\uC218\uB294 \uC7A0\uC2DC\uB3D9\uC548 \uC624\uB9AC\uB97C\\n\uBB34\uC801\uC73C\uB85C
      \uB9CC\uB4E4\uC5B4 \uC90D\uB2C8\uB2E4. "
  - hint: "\uAC01 \uC624\uB9AC\uB4E4\uC740 \uC2DC\uB108\uC9C0 \uC2A4\uD0AC\uC744
      \uC5BB\uC73C\uBA74\n\uC2DC\uB108\uC9C0 \uC624\uB9AC\uB85C \uBCC0\uC2E0\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - hint: "\uB3D9\uB8CC \uC624\uB9AC\uB4E4\uC774 \uB9AC\uB4DC \uC624\uB9AC\uB97C
      \n\uB458\uB7EC\uC2F8\uB3C4\uB85D \uD574\uBCF4\uC138\uC694. \n\uC801\uB4E4\uC758
      \uACF5\uACA9\uC744 \uB9C9\uC544 \uC904\uAC70\uC5D0\uC694."
  - hint: "\uB2EC\uCF64 \uC6B0\uC720\uB294 \uC6B0\uC8FC\uC5D0\uC11C \uAC00\uC7A5
      \uB9DB\uC788\uB294 \n\uC74C\uB8CC\uC218\uC785\uB2C8\uB2E4. \uCCB4\uB825\uAE4C\uC9C0
      \uCC44\uC6CC\uC90D\uB2C8\uB2E4!"
  - hint: "\uC2A4\uD14C\uC774\uC9C0 \uD074\uB9AC\uC5B4\uB97C \uACC4\uC18D \uC2E4\uD328\uD55C\uB2E4\uBA74\n\uCE74\uB4DC\uB97C
      \uC5C5\uADF8\uB808\uC774\uB4DC \uC2DC\uCF1C\uBCF4\uC138\uC694."
  - hint: "\uC624\uB9AC \uCE74\uB4DC\uB098 \uC544\uC774\uD15C \uCE74\uB4DC\uB97C
      \n\uD569\uC131\uD574\uC11C \uB354 \uB192\uC740 \uB2E8\uACC4\uC758 \uCE74\uB4DC\uB97C
      \n\uB9CC\uB4E4\uC5B4 \uBCF4\uC138\uC694!"
  - hint: "\uACBD\uD5D8\uCE58\uB97C \uC8FC\uB294 \uBCF4\uC11D\uC740\n\uC77C\uC815
      \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\n\uC11C\uB458\uB7EC\uC11C
      \uBCF4\uC11D\uC744 \uBAA8\uC73C\uC138\uC694!"
  hintIndex: 0
